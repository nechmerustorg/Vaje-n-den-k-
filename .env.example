# Tajný klíč pro autorizaci požadavků z frontendu.
# Doporučení: vygeneruj náhodný string, např. `openssl rand -hex 24`.
ACCESS_KEY=zde_nahradit_dlouhym_nahodnym_stringem

# Tyto proměnné nastaví Vercel automaticky při napojení KV storage:
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# --- Veřejné API pro prodejní web (Čerstvě sneseno) ---

# Origin webu pro CORS na /api/reserve a /api/reservations/*.
# Pro vývoj: http://localhost:3000, v produkci doména webu.
WEB_ORIGIN=

# Volitelné: Resend API klíč pro odesílání potvrzovacích emailů zákazníkům.
# Pokud chybí, rezervace se ukládá, ale email se neposílá (pickup kód se ukáže jen v UI).
# RESEND_API_KEY=
# RESEND_FROM=rezervace@cerstvesneseno.cz
# OWNER_NOTIFICATION_EMAIL=majitel@example.cz

# Volitelné: WhatsApp push chovateli přes CallMeBot (zdarma).
# Postup: chovatel uloží kontakt +34 644 51 95 23, pošle z WhatsAppu zprávu
# "I allow callmebot to send me messages" a obratem dostane 7-místný API klíč.
# OWNER_WHATSAPP_PHONE = mezinárodní formát bez +, např. 420777123456.
# CALLMEBOT_APIKEY=
# OWNER_WHATSAPP_PHONE=420777123456
